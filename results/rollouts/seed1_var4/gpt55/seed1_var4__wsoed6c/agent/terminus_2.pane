[?2004limport os
import time
import shlex

try:
    import utils
except ImportError:  # Allows importing as part of a package if needed.
    from . import utils


UPLOAD_DIR = "/workspace/uploads"
THUMBNAIL_DIR = "/workspace/thumbnails"


def generate_thumbnail(filename, scale_percent):
    """
    Generate a timestamped thumbnail for an uploaded image.

    Args:
        filename: Name of an image file located in /workspace/uploads/.
        scale_percent: Target size percentage, e.g. 50 for 50%.

    Returns:
        The generated thumbnail filename on success, otherwise None.
    """
    timestamp = int(time.time())
    output_filename = f"thumb_{timestamp}_{filename}"

    input_path = os.path.join(UPLOAD_DIR, filename)
    output_path = os.path.join(THUMBNAIL_DIR, output_filename)

    os.makedirs(THUMBNAIL_DIR, exist_ok=True)

    resize_arg = f"{scale_percent}%"
    cmd = (
        f"convert {shlex.quote(input_path)} "
        f"-resize {shlex.quote(resize_arg)} "
        f"{shlex.quote(output_path)}"
    )

    success, _ = utils.run_system_command(cmd)
    if success and os.path.isfile(output_path):
        return output_filename
    return None
