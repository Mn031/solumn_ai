[?2004limport os
import shlex
import time

import utils


UPLOAD_DIR = "/workspace/uploads"
THUMBNAIL_DIR = "/workspace/thumbnails"


def generate_thumbnail(filename, scale_percent):
    """
    Generate a timestamped thumbnail for an image in /workspace/uploads/.

    Returns the output thumbnail filename on success, or None on failure.
    All system command execution is performed via utils.run_system_command.
    """
    try:
        # Normalize and validate the requested percentage so only a numeric
        # resize value is passed to the shell command.
        percent_text = str(scale_percent).strip()
        if percent_text.endswith("%"):
            percent_text = percent_text[:-1].strip()
        percent = int(percent_text)
        if percent <= 0:
            return None

        timestamp = int(time.time())
        output_filename = f"thumb_{timestamp}_{filename}"
        input_path = os.path.join(UPLOAD_DIR, filename)
        output_path = os.path.join(THUMBNAIL_DIR, output_filename)

        os.makedirs(THUMBNAIL_DIR, exist_ok=True)

        cmd = (
            f"convert {shlex.quote(input_path)} "
            f"-resize {percent}% "
            f"{shlex.quote(output_path)}"
        )
        ok, _ = utils.run_system_command(cmd)
        if ok and os.path.isfile(output_path):
            return output_filename
        return None
    except Exception:
        return None
