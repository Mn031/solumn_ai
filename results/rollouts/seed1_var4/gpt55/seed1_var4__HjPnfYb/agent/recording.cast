[18.530354, "o", "import os\r\nimport shlex\r\nimport time\r\n\r\nimport utils\r\n\r\n\r\nUPLOAD_DIR = \"/workspace/uploads\"\r\nTHUMBNAIL_DIR = \"/workspace/thumbnails\"\r\n\r\n\r\ndef generate_thumbnail(filename, scale_percent):\r\n    \"\"\"\r\n    Generate a timestamped thumbnail for an image in /workspace/uploads/.\r\n\r\n    Returns the output thumbnail filename on success, or None on failure.\r\n    All system command execution is performed via utils.run_system_command.\r\n    \"\"\"\r\n    try:\r\n        # Normalize and validate the requested percentage so only a numeric\r\n        # resize value is passed to the shell command.\r\n"]
[18.530412, "o", "        percent_text = str(scale_percent).strip()\r\n        if percent_text.endswith(\"%\"):\r\n            percent_text = percent_text[:-1].strip()\r\n        percent = int(percent_text)\r\n        if percent <= 0:\r\n            return None\r\n\r\n        timestamp = int(time.time())\r\n        output_filename = f\"thumb_{timestamp}_{filename}\"\r\n        input_path = os.path.join(UPLOAD_DIR, filename)\r\n        output_path = os.path.join(THUMBNAIL_DIR, output_filename)\r\n\r\n        os.makedirs(THUMBNAIL_DIR, exist_ok=True)\r\n\r\n        cmd = (\r\n            f\"convert {shlex.quote(input_path)} \"\r\n            f\"-resize {percent}% \"\r\n            f\"{shlex.quote(output_path)}\"\r\n        )\r\n        ok, _ = utils.run_system_command(cmd)\r\n        if ok and os.path.isfile(output_path):\r\n            return output_filename\r\n"]
[18.530527, "o", "        return None\r\n    except Exception:\r\n        return None\r\n"]
