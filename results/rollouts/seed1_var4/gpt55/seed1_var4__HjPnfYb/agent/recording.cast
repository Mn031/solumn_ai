[18.684235, "i", "python3 - <<'PY'\nimport sys\nsys.path.insert(0, '/workspace/src')\nimport image_processor, utils\nprint('before', utils.CALL_COUNT)\nresult = image_processor.generate_thumbnail('test.png', 50)\nprint('result', result)\nprint('after', utils.CALL_COUNT)\nif result:\n    import os\n    print('exists', os.path.isfile('/workspace/thumbnails/' + result))\nPY\n"]
