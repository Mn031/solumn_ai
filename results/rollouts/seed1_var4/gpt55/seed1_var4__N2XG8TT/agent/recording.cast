[20.994705, "i", "if command -v convert >/dev/null 2>&1; then PYTHONPATH=src python3 - <<'PY'\nimport os\nimport image_processor\n\nresult = image_processor.generate_thumbnail('test.png', 50)\nprint(result)\nprint(os.path.exists('/workspace/thumbnails/' + result) if result else False)\nPY\nelse echo 'convert not installed; skipped functional check'; fi\n"]
