[?2004limport os
import subprocess


UPLOAD_DIR = "/workspace/uploads"
THUMBNAIL_DIR = "/workspace/thumbnails"


def generate_thumbnail(filename, extra_options: dict = None):
    """Generate a thumbnail for an uploaded image using ImageMagick's convert.

    Args:
        filename (str): Name of an image file located in /workspace/uploads/.
        extra_options (dict, optional): Additional convert CLI options, e.g.
            {"-resize": "50%", "-quality": "80"}.

    Returns:
        bool: True if the thumbnail file is generated successfully, False otherwise.
    """
    if not isinstance(filename, str) or not filename:
        return False

    input_path = os.path.join(UPLOAD_DIR, filename)
    output_path = os.path.join(THUMBNAIL_DIR, f"thumb_{filename}")

    try:
        os.makedirs(os.path.dirname(output_path), exist_ok=True)

        command = ["convert", input_path]

        if extra_options:
            for key, value in extra_options.items():
                command.append(str(key))
                if value is not None:
                    command.append(str(value))

        command.append(output_path)

        result = subprocess.run(
            command,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
        )

        return result.returncode == 0 and os.path.exists(output_path)
    except Exception:
        return False
