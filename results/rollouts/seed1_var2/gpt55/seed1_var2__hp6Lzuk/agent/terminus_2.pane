[?2004l[?2004h> 
[?2004l[?2004h>     if not os.path.isfile(input_path):
[?2004l[?2004h>         return False
[?2004l[?2004h> 
[?2004l[?2004h>     try:
[?2004l[?2004h>         os.makedirs(THUMBNAIL_DIR, exist_ok=True)
