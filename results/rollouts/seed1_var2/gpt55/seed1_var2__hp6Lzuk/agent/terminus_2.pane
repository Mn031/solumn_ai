[?2004l[?2004h> 
[?2004l[?2004h>     Returns:
[?2004l[?2004h>         bool: True if the thumbnail file is generated successfully, False otherwise.
[?2004l[?2004h>     """
[?2004l[?2004h>     if not isinstance(filename, str) or not filename:
