[23.80292, "i", "cat > src/image_processor.py <<'PY'\nimport os\nimport subprocess\n\n\nUPLOAD_DIR = \"/workspace/uploads\"\nTHUMBNAIL_DIR = \"/workspace/thumbnails\"\n\n\ndef generate_thumbnail(filename, extra_options: dict = None):\n    \"\"\"Generate a thumbnail for an uploaded image using ImageMagick's convert.\n\n    Args:\n        filename (str): Name of an image file located in /workspace/uploads/.\n        extra_options (dict, optional): Additional convert CLI options, e.g.\n            {\"-resize\": \"50%\", \"-quality\": \"80\"}.\n\n    Returns:\n        bool: True if the thumbnail file is generated successfully, False otherwise.\n    \"\"\"\n    if not isinstance(filename, str) or not filename:\n        return False\n\n    # The requirement is for a file name inside UPLOAD_DIR, not an arbitrary path.\n    # Reject absolute paths and path traversal/subdirectory components.\n    if os.path.isabs(filename) or os.path.basename(filename) != filename:\n        return False\n\n    if extra_options is not None and not isinstance(extra_options, dict):\n        return False\n\n    input_path = os.path.join(UPLOAD_DIR, filename)\n    output_path = os.path.join(THUMBNAIL_DIR, f\"thumb_{filename}\")\n\n    if not os.path.isfile(input_path):\n        return False\n\n    try:\n        os.makedirs(THUMBNAIL_DIR, exist_ok=True)\n\n        command = [\"convert\", input_path]\n\n        if extra_options:\n            for option, value in extra_options.items():\n                # Allow flag-style options with True/None values, e.g. {\"-strip\": None}.\n                # Skip explicitly disabled options.\n                if value is False:\n                    continue\n\n                command.append(str(option))\n\n                if value is not None and value is not True:\n                    if isinstance(value, (list, tuple)):\n                        command.extend(str(item) for item in value)\n                    else:\n                        command.append(str(value))\n\n        command.append(output_path)\n\n        subprocess.run(\n            command,\n            stdout=subprocess.PIPE,\n            stderr=subprocess.PIPE,\n            check=True,\n        )\n\n        return os.path.isfile(output_path)\n    except (OSError, subprocess.SubprocessError):\n        return False\nPY\npython3 -m py_compile src/image_processor.py\npython3 - <<'PY'\nfrom src.image_processor import generate_thumbnail\nprint(generate_thumbnail('test.png', {'-resize': '50%'}))\nPY\nls -l thumbnails\n"]
