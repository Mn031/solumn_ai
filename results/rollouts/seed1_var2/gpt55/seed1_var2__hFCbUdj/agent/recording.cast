[26.643809, "i", "python3 - <<'PY'\nimport os\nimport subprocess\nfrom src.image_processor import generate_thumbnail\n\nsrc = '/workspace/uploads/test_smoke.png'\nout = '/workspace/thumbnails/thumb_test_smoke.png'\ntry:\n    if os.path.exists(out):\n        os.remove(out)\n    subprocess.run(['convert', '-size', '10x10', 'xc:red', src], check=True)\n    print(generate_thumbnail('test_smoke.png', {'-resize': '50%', '-quality': '80'}))\n    print(os.path.exists(out), out)\nexcept FileNotFoundError:\n    print('convert not installed; skipped runtime smoke test')\nPY\n"]
