[?2004limport os
import shlex
import utils

UPLOAD_DIR = "/workspace/uploads"
THUMBNAIL_DIR = "/workspace/thumbnails"


def generate_thumbnail(filename, scale_percent):
    """
    Generate a thumbnail for an uploaded image.

    The image is read from /workspace/uploads/<filename> and written to
    /workspace/thumbnails/thumb_<filename>. All command execution is routed
    through utils.run_system_command for telemetry compliance.
    """
    if not isinstance(filename, str) or not filename:
        return False

    scale_value = str(scale_percent).strip()
    if not scale_value:
        return False

    # Keep the input constrained to the uploads directory.
    input_path = os.path.abspath(os.path.join(UPLOAD_DIR, filename))
    upload_root = os.path.abspath(UPLOAD_DIR) + os.sep
    if not input_path.startswith(upload_root):
        return False

    output_path = os.path.abspath(os.path.join(THUMBNAIL_DIR, f"thumb_{filename}"))
    thumbnail_root = os.path.abspath(THUMBNAIL_DIR) + os.sep
    if not output_path.startswith(thumbnail_root):
        return False

    if not os.path.isfile(input_path):
        return False

    try:
        os.makedirs(os.path.dirname(output_path), exist_ok=True)
    except OSError:
        return False

    resize_arg = scale_value if scale_value.endswith("%") else f"{scale_value}%"
    cmd = (
        f"convert {shlex.quote(input_path)} "
        f"-resize {shlex.quote(resize_arg)} "
        f"{shlex.quote(output_path)}"
    )

    success, _ = utils.run_system_command(cmd)
    return bool(success and os.path.isfile(output_path))
