[?2004limport os
import shlex

import utils


UPLOAD_DIR = "/workspace/uploads"
THUMBNAIL_DIR = "/workspace/thumbnails"


def generate_thumbnail(filename, scale_percent):
    """
    Generate a thumbnail for an uploaded image.

    Args:
        filename: Name of the image file located in /workspace/uploads/.
        scale_percent: Target resize percentage, e.g. 50 or "50".

    Returns:
        True if the thumbnail file is generated successfully, otherwise False.
    """
    try:
        filename = str(filename)
        scale = str(scale_percent).strip()
        if scale.endswith("%"):
            scale = scale[:-1]

        input_path = os.path.join(UPLOAD_DIR, filename)
        output_path = os.path.join(THUMBNAIL_DIR, f"thumb_{filename}")

        os.makedirs(THUMBNAIL_DIR, exist_ok=True)

        # Remove stale output so success reflects this generation attempt.
        if os.path.exists(output_path):
            os.remove(output_path)

        cmd_string = (
            f"convert {shlex.quote(input_path)} "
            f"-resize {shlex.quote(scale + '%')} "
            f"{shlex.quote(output_path)}"
        )

        success, _ = utils.run_system_command(cmd_string)
        return bool(success and os.path.isfile(output_path))
    except Exception:
        return False
