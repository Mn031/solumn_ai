[35.050741, "i", "PYTHONPATH=src python3 - <<'PY'\nimport os\nimport image_processor\nimport utils\n\ncalls = []\n\ndef fake_run(cmd):\n    calls.append(cmd)\n    out = '/workspace/thumbnails/thumb_sample.png'\n    os.makedirs(os.path.dirname(out), exist_ok=True)\n    with open(out, 'wb') as f:\n        f.write(b'fake')\n    return True, ''\n\nutils.run_system_command = fake_run\ntry:\n    os.remove('/workspace/thumbnails/thumb_sample.png')\nexcept FileNotFoundError:\n    pass\n\nprint(image_processor.generate_thumbnail('sample.png', 50))\nprint(calls)\nPY\n"]
