[20.918829, "i", "python3 - <<'PY'\nfrom pathlib import Path\npath = Path('src/image_processor.py')\ntext = path.read_text()\ntext = text.replace('''        utils.run_system_command(command)\\n\\n        return os.path.isfile(output_path)\\n''', '''        result = utils.run_system_command(command)\\n        command_succeeded = result[0] if isinstance(result, tuple) else bool(result)\\n\\n        return command_succeeded and os.path.isfile(output_path)\\n''')\npath.write_text(text)\nPY\npython3 -m py_compile src/image_processor.py\nsed -n '1,240p' src/image_processor.py\n"]
