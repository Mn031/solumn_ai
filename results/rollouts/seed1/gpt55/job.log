Sending keys: ['cat > src/image_processor.py <<\'PY\'\nimport os\nimport subprocess\n\nUPLOAD_DIR = "/workspace/uploads"\nTHUMBNAIL_DIR = "/workspace/thumbnails"\n\n\ndef generate_thumbnail(filename, scale_percent):\n    """\n    Generate a thumbnail for an image in /workspace/uploads/.\n\n    The thumbnail is saved to /workspace/thumbnails/thumb_<filename>.\n    Returns True when the output file is successfully generated; otherwise False.\n    """\n    try:\n        filename = str(filename)\n\n        # filename is expected to be a file name inside UPLOAD_DIR, not a path.\n        if not filename or os.path.basename(filename) != filename:\n            return False\n\n        scale = str(scale_percent).strip()\n        if scale.endswith("%"):\n            scale = scale[:-1]\n        if not scale:\n            return False\n\n        input_path = os.path.join(UPLOAD_DIR, filename)\n        output_path = os.path.join(THUMBNAIL_DIR, f"thumb_{filename}")\n\n        os.makedirs(THUMBNAIL_DIR, exist_ok=True)\n\n        result = subprocess.run(\n            ["convert", input_path, "-resize", f"{scale}%", output_path],\n            capture_output=True,\n            text=True,\n            check=False,\n        )\n\n        return result.returncode == 0 and os.path.isfile(output_path)\n    except Exception:\n        return False\nPY\npython3 -m py_compile src/image_processor.py\npython3 - <<\'PY\'\nimport sys, os\nsys.path.insert(0, \'/workspace/src\')\nfrom image_processor import generate_thumbnail\nprint(generate_thumbnail(\'test.png\', 50))\nprint(os.path.isfile(\'/workspace/thumbnails/thumb_test.png\'))\nPY\nls -la thumbnails\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
