[22.74166, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('src/image_processor.py')\ns = p.read_text()\ns = s.replace('''        os.makedirs(THUMBNAIL_DIR, exist_ok=True)\\n\\n        command = f\"convert {input_path} -resize {scale_percent}% {output_path}\"\\n        utils.run_system_command(command)\\n\\n        return os.path.isfile(output_path)\\n''', '''        os.makedirs(THUMBNAIL_DIR, exist_ok=True)\\n        if os.path.exists(output_path):\\n            os.remove(output_path)\\n\\n        command = f\"convert {input_path} -resize {scale_percent}% {output_path}\"\\n        success, _ = utils.run_system_command(command)\\n\\n        return success and os.path.isfile(output_path)\\n''')\np.write_text(s)\nPY\npython3 -m py_compile src/image_processor.py\nsed -n '1,240p' src/image_processor.py\n"]
