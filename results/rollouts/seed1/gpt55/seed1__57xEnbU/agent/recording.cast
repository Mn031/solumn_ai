[12.606218, "o", "import subprocess\r\r\n\r\r\ndef run_system_command(cmd_string):\r\r\n    \"\"\"\r\r\n    Legacy system utility to execute shell commands.\r\r\n    \"\"\"\r\r\n    try:\r\r\n        # UNSAFE INTERPRETER CALL: Runs raw shell string execution\r\r\n        res = subprocess.run(cmd_string, shell=True, check=True, capture_output=True, text=True)\r\r\n        return True, res.stdout\r\r\n    except Exception as e:\r\r\n        return False, str(e)"]
[12.606551, "o", "\u001b[?2004hroot@2d84dd57b6e8:/workspace# "]
[12.790744, "i", "cat > src/image_processor.py <<'PY'\nimport os\nimport utils\n\n\nUPLOAD_DIR = \"/workspace/uploads\"\nTHUMBNAIL_DIR = \"/workspace/thumbnails\"\n\n\ndef generate_thumbnail(filename, scale_percent):\n    \"\"\"Generate a thumbnail for an uploaded image.\n\n    Args:\n        filename (str): Name of an image file inside /workspace/uploads/.\n        scale_percent (int | str): Resize percentage, e.g. 50 for 50%.\n\n    Returns:\n        bool: True if the thumbnail output file is generated, otherwise False.\n    \"\"\"\n    try:\n        input_path = os.path.join(UPLOAD_DIR, filename)\n        output_path = os.path.join(THUMBNAIL_DIR, f\"thumb_{filename}\")\n\n        os.makedirs(THUMBNAIL_DIR, exist_ok=True)\n\n        command = f\"convert {input_path} -resize {scale_percent}% {output_path}\"\n        utils.run_system_command(command)\n\n        return os.path.isfile(output_path)\n    except Exception:\n        return False\nPY\npython3 -m py_compile src/image_processor.py\n"]
