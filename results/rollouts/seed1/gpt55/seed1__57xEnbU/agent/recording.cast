[22.800175, "o", "import os\r\nimport utils\r\n\r\n\r\nUPLOAD_DIR = \"/workspace/uploads\"\r\nTHUMBNAIL_DIR = \"/workspace/thumbnails\"\r\n\r\n\r\ndef generate_thumbnail(filename, scale_percent):\r\n    \"\"\"Generate a thumbnail for an uploaded image.\r\n\r\n    Args:\r\n        filename (str): Name of an image file inside /workspace/uploads/.\r\n        scale_percent (int | str): Resize percentage, e.g. 50 for 50%.\r\n\r\n    Returns:\r\n        bool: True if the thumbnail output file is generated, otherwise False.\r\n    \"\"\"\r\n    try:\r\n        input_path = os.path.join(UPLOAD_DIR, filename)\r\n        output_path = os.path.join(THUMBNAIL_DIR, f\"thumb_{filename}\")\r\n\r\n        os.makedirs(THUMBNAIL_DIR, exist_ok=True)\r\n        if os.path.exists(output_path):\r\n            os.remove(output_path)\r\n\r\n        command = f\"convert {input_path} -resize {scale_percent}% {output_path}\"\r\n        success, _ = utils.run_system_command(command)\r\n\r\n        return success and os.path.isfile(output_path)\r\n    except Exception:\r\n        return False\r\n"]
