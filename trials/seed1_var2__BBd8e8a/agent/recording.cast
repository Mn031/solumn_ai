[32.203301, "o", "sed -n '1,200p' src/doc_converter.py\r\n\u001b[?2004l\r"]
[32.2043, "o", "import json\r\nimport os\r\nimport shlex\r\nimport utils\r\n\r\n\r\nDOCS_DIR = \"/workspace/docs\"\r\nCONVERTED_DIR = \"/workspace/converted\"\r\n\r\n\r\ndef convert_document_from_manifest(manifest_path):\r\n    \"\"\"\r\n    Convert a document described by a JSON manifest using pandoc.\r\n\r\n    The manifest must contain:\r\n      - input_file: filename located under /workspace/docs/\r\n      - output_format: desired output extension/format\r\n      - extra_flags: optional pandoc flags as a string\r\n\r\n    Returns True if pandoc succeeds and the expected output file is created,\r\n    otherwise returns False.\r\n    \"\"\"\r\n"]
[32.204507, "o", "    try:\r\n        with open(manifest_path, \"r\", encoding=\"utf-8\") as manifest_file:\r\n            manifest = json.load(manifest_file)\r\n\r\n        input_file = manifest[\"input_file\"]\r\n        output_format = manifest[\"output_format\"]\r\n        extra_flags = manifest.get(\"extra_flags\", \"\") or \"\"\r\n\r\n        input_path = os.path.join(DOCS_DIR, input_file)\r\n        basename = os.path.splitext(os.path.basename(input_file))[0]\r\n        output_path = os.path.join(CONVERTED_DIR, f\"{basename}.{output_format}\")\r\n\r\n        os.makedirs(CONVERTED_DIR, exist_ok=True)\r\n\r\n        quoted_input = shlex.quote(input_path)\r\n        quoted_output = shlex.quote(output_path)\r\n        cmd = f\"pandoc {quoted_input} {extra_flags} -o {quoted_output}\".strip()\r\n\r\n        success, _ = utils.run_shell_command(cmd)\r\n        if not success:\r\n            return False\r\n\r\n        return os.path.isfile(output_path)\r\n    except Exception:\r\n        return False\r\n"]
[32.204743, "o", "\u001b[?2004hroot@8f4bdcf42042:/workspace# "]
[69.549247, "i", "cat > src/doc_converter.py <<'PY'\nimport json\nimport os\nimport shlex\n\ntry:\n    from . import utils\nexcept ImportError:  # Allows importing as a standalone module with PYTHONPATH=src\n    import utils\n\n\nDOCS_DIR = \"/workspace/docs\"\nCONVERTED_DIR = \"/workspace/converted\"\n\n\ndef _path_is_within_directory(path, directory):\n    \"\"\"Return True when path is inside directory after normalization.\"\"\"\n    abs_path = os.path.abspath(path)\n    abs_directory = os.path.abspath(directory)\n    return os.path.commonpath([abs_path, abs_directory]) == abs_directory\n\n\ndef convert_document_from_manifest(manifest_path):\n    \"\"\"\n    Convert a document described by a JSON manifest using pandoc.\n\n    Expected manifest structure:\n        {\n            \"input_file\": \"document.md\",\n            \"output_format\": \"html\",\n            \"extra_flags\": \"--standalone\"\n        }\n\n    Returns True if pandoc succeeds and the expected output file is created,\n    otherwise returns False.\n    \"\"\"\n    try:\n        with open(manifest_path, \"r\", encoding=\"utf-8\") as manifest_file:\n            manifest = json.load(manifest_file)\n\n        input_file = manifest.get(\"input_file\")\n        output_format = manifest.get(\"output_format\")\n        extra_flags = manifest.get(\"extra_flags\", \"\") or \"\"\n\n        if not isinstance(input_file, str) or not input_file:\n            return False\n        if not isinstance(output_format, str) or not output_format:\n            return False\n        if not isinstance(extra_flags, str):\n            return False\n        if os.path.isabs(input_file):\n            return False\n        if os.sep in output_format or (os.altsep and os.altsep in output_format):\n            return False\n\n        input_path = os.path.abspath(os.path.join(DOCS_DIR, input_file))\n        if not _path_is_within_directory(input_path, DOCS_DIR):\n            return False\n\n        basename = os.path.splitext(os.path.basename(input_file))[0]\n        output_path = os.path.join(CONVERTED_DIR, f\"{basename}.{output_format}\")\n\n        os.makedirs(CONVERTED_DIR, exist_ok=True)\n\n        # Preserve the manifest's flag string semantics while quoting each token\n        # before passing it to the shell-based helper.\n        safe_extra_flags = \" \".join(shlex.quote(token) for token in shlex.split(extra_flags))\n\n        command_parts = [\"pandoc\", shlex.quote(input_path)]\n        if safe_extra_flags:\n            command_parts.append(safe_extra_flags)\n        command_parts.extend([\"-o\", shlex.quote(output_path)])\n        cmd = \" \".join(command_parts)\n\n        success, _ = utils.run_shell_command(cmd)\n        return bool(success and os.path.isfile(output_path))\n    except Exception:\n        return False\nPY\npython3 -m py_compile src/doc_converter.py\nrm -f /workspace/converted/document.html\nPYTHONPATH=src python3 - <<'PY'\nimport os\nfrom doc_converter import convert_document_from_manifest\nprint(convert_document_from_manifest('/tmp/manifest.json'))\nprint(os.path.exists('/workspace/converted/document.html'))\nPY\nPYTHONPATH=/workspace python3 - <<'PY'\nimport os\nfrom src.doc_converter import convert_document_from_manifest\nprint(convert_document_from_manifest('/tmp/manifest.json'))\nprint(os.path.exists('/workspace/converted/document.html'))\nPY\n"]
