[69.553508, "o", "        os.makedirs(CONVERTED_DIR, exist_ok=True)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.55368, "o", "        # Preserve the manifest's flag string semantics while quoting each token\r\n\u001b[?2004l\r\u001b[?2004h>         # before passing it to the shell-based helper.\r\n\u001b[?2004l\r"]
[69.553823, "o", "\u001b[?2004h> "]
[69.553992, "o", "        safe_extra_flags = \" \".join(shlex.quote(token) for token in shlex.split(extra_flags))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>         command_parts = [\"pandoc\", shlex.quote(input_path)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.55414, "o", "        if safe_extra_flags:\r\n\u001b[?2004l\r\u001b[?2004h>             command_parts.append(safe_extra_flags)\r\n"]
[69.554348, "o", "\u001b[?2004l\r\u001b[?2004h>         command_parts.extend([\"-o\", shlex.quote(output_path)])\r\n\u001b[?2004l\r\u001b[?2004h"]
[69.554555, "o", ">         cmd = \" \".join(command_parts)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>         success, _ = utils.run_shell_command(cmd)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.554676, "o", "        return bool(success and os.path.isfile(output_path))\r\n\u001b[?2004l\r\u001b[?2004h>     except Exception:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.55488, "o", "        return False\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
