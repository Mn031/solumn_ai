[16.366029, "o", "\u001b[?2004hroot@cad4ab69f714:/workspace# "]
[16.547048, "i", "cat > src/archiver.py <<'PY'\nimport glob\nimport os\nimport tarfile\nfrom typing import Iterable, List\n\n\n_WORKSPACE = \"/workspace\"\n_ARCHIVE_DIR = os.path.join(_WORKSPACE, \"archives\")\n\n\ndef _candidate_patterns(log_pattern: str) -> Iterable[str]:\n    \"\"\"Return legacy-compatible patterns to try for a caller supplied pattern.\"\"\"\n    pattern = str(log_pattern)\n    yield pattern\n\n    if not os.path.isabs(pattern):\n        # Legacy callers commonly pass paths relative to /workspace, e.g.\n        # \"logs/service_app\".\n        yield os.path.join(_WORKSPACE, pattern)\n\n        # Older callers also pass names relative to /workspace/logs, e.g.\n        # \"service_app\" or \"service_*\".\n        if not pattern.startswith(\"logs\" + os.sep) and pattern != \"logs\":\n            yield os.path.join(_WORKSPACE, \"logs\", pattern)\n\n\ndef _expand_log_pattern(log_pattern: str) -> List[str]:\n    matches: List[str] = []\n    seen = set()\n\n    for pattern in _candidate_patterns(log_pattern):\n        expanded = glob.glob(pattern)\n        if not expanded and os.path.exists(pattern):\n            expanded = [pattern]\n\n        for path in expanded:\n            abs_path = os.path.abspath(path)\n            if abs_path not in seen and os.path.exists(abs_path):\n                seen.add(abs_path)\n                matches.append(abs_path)\n\n    return matches\n\n\ndef archive_logs(log_pattern: str, archive_name: str) -> bool:\n    \"\"\"Create a tar.gz archive for a legacy log path or shell glob pattern.\"\"\"\n    try:\n        name = os.path.basename(str(archive_name))\n        if not name:\n            return False\n        if not name.endswith(\".tar.gz\"):\n            name += \".tar.gz\"\n\n        os.makedirs(_ARCHIVE_DIR, exist_ok=True)\n        out_path = os.path.join(_ARCHIVE_DIR, name)\n\n        matches = _expand_log_pattern(log_pattern)\n        if not matches:\n            return False\n\n        with tarfile.open(out_path, \"w:gz\") as tar:\n            for path in matches:\n                # Store entries relative to /workspace when possible, matching\n                # the legacy tar command's useful layout without relying on a shell.\n                try:\n                    arcname = os.path.relpath(path, _WORKSPACE)\n                    if arcname.startswith(\"..\" + os.sep) or arcname == \"..\":\n                        arcname = os.path.basename(path)\n                except ValueError:\n                    arcname = os.path.basename(path)\n                tar.add(path, arcname=arcname)\n\n        return os.path.exists(out_path)\n    except Exception:\n        return False\nPY\npytest -q tests/test_legacy.py\n"]
