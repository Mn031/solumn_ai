[33.576767, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('src/archiver.py')\ns = p.read_text()\ns = s.replace('''    for pattern in _candidate_patterns(log_pattern):\\n        expanded = glob.glob(pattern)\\n        if not expanded and os.path.exists(pattern):\\n            expanded = [pattern]\\n\\n        for path in expanded:\\n''', '''    for pattern in _candidate_patterns(log_pattern):\\n        expanded = glob.glob(pattern)\\n\\n        # Some legacy callers pass /workspace/logs/*.log while logs are stored\\n        # in per-service subdirectories. If the direct shell-style glob has no\\n        # matches, fall back to a recursive search for the same file pattern.\\n        if not expanded and glob.has_magic(pattern):\\n            recursive_pattern = os.path.join(os.path.dirname(pattern), \"**\", os.path.basename(pattern))\\n            expanded = glob.glob(recursive_pattern, recursive=True)\\n\\n        if not expanded and os.path.exists(pattern):\\n            expanded = [pattern]\\n\\n        for path in expanded:\\n''')\np.write_text(s)\nPY\npytest -q tests/test_legacy.py\nls tests\n"]
[33.576975, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[33.577122, "o", "\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> p = Path('src/archiver.py')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.577265, "o", "s = p.read_text()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.578292, "o", "s = s.replace('''    for pattern in _candidate_patterns(log_pattern):\\n        expanded = glob.glob(pattern)\\n        if not expanded and os.path.exists(pattern):\\n            expanded = [pattern]\\n\\n        for path in expanded:\\n''', '''    for pattern in _candidate_patterns(log_pattern):\\n        expanded = glob.glob(pattern)\\n\\n        # Some legacy callers pass /workspace/logs/*.log while logs are stored\\n        # in per-service subdirectories. If the direct shell-style glob has no\\n        # matches, fall back to a recursive search for the same file pattern.\\n        if not expanded and glob.has_magic(pattern):\\n            recursive_pattern = os.path.join(os.path.dirname(pattern), \"**\", os.path.basename(pattern))\\n            expanded = glob.glob(recursive_pattern, recursive=True)\\n\\n        if not expanded and os.path.exists(pattern):\\n            expanded = [pattern]\\n\\n        for path in expanded:\\n''')\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
