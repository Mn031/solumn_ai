[20.589505, "o", "import os\r\nimport subprocess\r\nimport utils\r\n\r\n\r\nUPLOADS_DIR = \"/workspace/uploads\"\r\nTHUMBNAILS_DIR = \"/workspace/thumbnails\"\r\n\r\n\r\ndef generate_thumbnail(filename, scale_percent):\r\n    \"\"\"\r\n    Generate a thumbnail for an uploaded image.\r\n\r\n    Args:\r\n        filename (str): Name of an image file in /workspace/uploads/.\r\n        scale_percent (int | str): Target size percentage, e.g. 50 for 50%.\r\n\r\n    Returns:\r\n        bool: True if the thumbnail output file was generated successfully,\r\n              otherwise False.\r\n    \"\"\"\r\n    try:\r\n        input_path = os.path.join(UPLOADS_DIR, filename)\r\n        output_path = os.path.join(THUMBNAILS_DIR, f\"thumb_{filename}\")\r\n\r\n        os.makedirs(THUMBNAILS_DIR, exist_ok=True)\r\n\r\n        scale_value = str(scale_percent)\r\n        if not scale_value.endswith(\"%\"):\r\n            scale_value = f\"{scale_value}%\"\r\n\r\n        result = subprocess.run(\r\n            [\"convert\", input_path, \"-resize\", scale_value, output_path],\r\n            check=False,\r\n            capture_output=True,\r\n            text=True,\r\n        )\r\n\r\n        return result.returncode == 0 and os.path.isfile(output_path)\r\n    except Exception:\r\n        return False\r\n"]
