[14.822235, "o", "\u001b[?2004hroot@686e00f1d048:/workspace# "]
[15.129449, "i", "cat > src/video_processor.py <<'PY'\nimport os\nimport subprocess\n\n\ndef extract_frame(video_filename: str, timestamp_sec: int, output_filename: str = None) -> bool:\n    \"\"\"\n    Extracts a single frame from a video in /workspace/videos/ at the given\n    timestamp and writes it to /workspace/frames/<output_filename>.\n\n    Returns True if the frame image is created successfully and exists,\n    otherwise False.\n    \"\"\"\n    videos_dir = \"/workspace/videos\"\n    frames_dir = \"/workspace/frames\"\n\n    input_path = os.path.join(videos_dir, video_filename)\n\n    if output_filename is None:\n        output_filename = f\"frame_{timestamp_sec}.png\"\n\n    output_path = os.path.join(frames_dir, output_filename)\n\n    try:\n        os.makedirs(frames_dir, exist_ok=True)\n        subprocess.run(\n            [\n                \"ffmpeg\",\n                \"-y\",\n                \"-ss\",\n                str(timestamp_sec),\n                \"-i\",\n                input_path,\n                \"-frames:v\",\n                \"1\",\n                output_path,\n            ],\n            check=True,\n            stdout=subprocess.DEVNULL,\n            stderr=subprocess.DEVNULL,\n        )\n    except Exception:\n        return False\n\n    return os.path.exists(output_path)\nPY\npython3 -m py_compile src/video_processor.py\n"]
[15.129913, "o", "cat > src/video_processor.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[15.130218, "o", "import os\r\n\u001b[?2004l\r\u001b[?2004h> import subprocess\r\n\u001b[?2004l\r"]
