[48.052478, "i", "cat > src/image_processor.py <<'PY'\nimport os\nimport subprocess\n\n\nUPLOAD_DIR = \"/workspace/uploads\"\nTHUMBNAIL_DIR = \"/workspace/thumbnails\"\n\n\ndef generate_thumbnail(filename, scale_percent):\n    \"\"\"Generate a thumbnail for an uploaded image.\n\n    Args:\n        filename (str): Name of an image file located in /workspace/uploads/.\n        scale_percent (int | str): Resize percentage, e.g. 50 for 50%.\n\n    Returns:\n        bool: True if the thumbnail file was generated successfully, False otherwise.\n    \"\"\"\n    input_path = os.path.join(UPLOAD_DIR, filename)\n    output_path = os.path.join(THUMBNAIL_DIR, f\"thumb_{filename}\")\n\n    try:\n        os.makedirs(THUMBNAIL_DIR, exist_ok=True)\n        subprocess.run(\n            [\"convert\", input_path, \"-resize\", f\"{scale_percent}%\", output_path],\n            check=True,\n            capture_output=True,\n            text=True,\n        )\n        return os.path.isfile(output_path)\n    except Exception:\n        return False\nPY\nrm -f /workspace/thumbnails/thumb_test.png\npython3 -m py_compile src/image_processor.py\n"]
