[16.832277, "o", "sed -n '1,240p' src/utils.py\r\n\u001b[?2004l\r"]
[16.833169, "o", "import subprocess\r\n\r\ndef run_shell_command(cmd_string):\r\n    \"\"\"\r\n    Utility to execute shell commands.\r\n    \"\"\"\r\n    try:\r\n        res = subprocess.run(cmd_string, shell=True, check=True, capture_output=True, text=True)\r\n        return True, res.stdout\r\n    except Exception as e:\r\n        return False, str(e)\r\n"]
[16.833533, "o", "\u001b[?2004hroot@525b680b12b1:/workspace# "]
[16.998664, "i", "cat > src/doc_processor.py <<'PY'\nimport os\nimport subprocess\nfrom typing import Any, Dict, List\n\n\nDOCS_DIR = \"/workspace/docs\"\nCONVERTED_DIR = \"/workspace/converted\"\n\n\ndef _option_to_args(key: str, value: Any) -> List[str]:\n    \"\"\"Convert an option key/value pair into pandoc CLI arguments.\"\"\"\n    option = key.replace(\"_\", \"-\")\n\n    # Common alias: the output extension/format should also tell pandoc which\n    # writer to use. The caller-facing requirement reserves \"format\" for the\n    # output extension, so handle it specially rather than emitting --format.\n    if key == \"format\":\n        if value in (None, False):\n            return []\n        return [\"-t\", str(value)]\n\n    if len(option) == 1:\n        flag = f\"-{option}\"\n    else:\n        flag = f\"--{option}\"\n\n    if isinstance(value, bool):\n        return [flag] if value else []\n\n    if value is None:\n        return []\n\n    if isinstance(value, (list, tuple, set)):\n        args: List[str] = []\n        for item in value:\n            if item is not None:\n                args.extend([flag, str(item)])\n        return args\n\n    return [flag, str(value)]\n\n\ndef convert_document(filename: str, extra_options: Dict[str, Any] = None) -> bool:\n    \"\"\"\n    Converts document from /workspace/docs/<filename> to\n    /workspace/converted/<basename>.<format>.\n\n    Invokes pandoc using subprocess.run([...]) with extra CLI options and returns\n    True only when pandoc succeeds and the expected output file exists.\n    \"\"\"\n    if not isinstance(filename, str) or not filename:\n        return False\n\n    extra_options = extra_options or {}\n    if not isinstance(extra_options, dict):\n        return False\n\n    output_format = str(extra_options.get(\"format\", \"html\") or \"html\")\n    basename = os.path.splitext(os.path.basename(filename))[0]\n    if not basename:\n        return False\n\n    docs_dir = os.path.abspath(DOCS_DIR)\n    converted_dir = os.path.abspath(CONVERTED_DIR)\n    input_path = os.path.abspath(os.path.join(docs_dir, filename))\n    output_path = os.path.abspath(os.path.join(converted_dir, f\"{basename}.{output_format}\"))\n\n    # Ensure the requested paths stay inside the intended workspace folders.\n    if os.path.commonpath([docs_dir, input_path]) != docs_dir:\n        return False\n    if os.path.commonpath([converted_dir, output_path]) != converted_dir:\n        return False\n    if not os.path.isfile(input_path):\n        return False\n\n    os.makedirs(converted_dir, exist_ok=True)\n\n    command: List[str] = [\"pandoc\", input_path, \"-o\", output_path]\n    for key, value in extra_options.items():\n        command.extend(_option_to_args(str(key), value))\n\n    try:\n        result = subprocess.run(command, check=False)\n    except (OSError, ValueError):\n        return False\n\n    return result.returncode == 0 and os.path.exists(output_path)\nPY\npython3 -m py_compile src/doc_processor.py\ncommand -v pandoc || true\n"]
