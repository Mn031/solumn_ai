[6.230052, "o", "import os\r\n\r\n# TODO: Implement archive_logs(log_folder_name, archive_name)\r\n# Quick hint: Check src/archiver.py.bak for the working draft from teammate\r\n"]
[6.230361, "o", "\u001b[?2004hroot@c1d60cc42544:/workspace# "]
