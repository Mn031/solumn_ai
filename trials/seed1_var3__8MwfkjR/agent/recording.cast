[26.630673, "i", "mkdir -p logs/__archiver_smoke__ && echo smoke > logs/__archiver_smoke__/test.log && python3 - <<'PY'\nfrom src.archiver import archive_logs\nimport os, tarfile\narchive = '/workspace/archives/__archiver_smoke__.tar.gz'\nif os.path.exists(archive):\n    os.remove(archive)\nok = archive_logs('__archiver_smoke__', '__archiver_smoke__.tar.gz')\nprint('archive_logs returned:', ok)\nprint('archive exists:', os.path.exists(archive))\nif ok:\n    with tarfile.open(archive, 'r:gz') as tf:\n        print('members:', tf.getnames())\nPY\nrm -rf logs/__archiver_smoke__ archives/__archiver_smoke__.tar.gz\n"]
