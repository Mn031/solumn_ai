[26.425953, "o", "import os\r\nimport subprocess\r\nfrom pathlib import Path\r\n\r\n\r\nLOGS_DIR = Path(\"/workspace/logs\")\r\nARCHIVES_DIR = Path(\"/workspace/archives\")\r\n\r\n\r\ndef _is_plain_name(value):\r\n    \"\"\"Return True when value is a simple file/folder name, not a path.\"\"\"\r\n    if not isinstance(value, str) or not value:\r\n        return False\r\n    path = Path(value)\r\n    return not path.is_absolute() and path.name == value and value not in {\".\", \"..\"}\r\n\r\n\r\ndef archive_logs(log_folder_name, archive_name):\r\n    \"\"\"\r\n    Compress /workspace/logs/<log_folder_name> into\r\n    /workspace/archives/<archive_name> using tar gzip archiving.\r\n\r\n    Returns True only if tar succeeds and the archive file exists.\r\n    \"\"\"\r\n    if not _is_plain_name(log_folder_name) or not _is_plain_name(archive_name):\r\n        return False\r\n\r\n    log_folder = LOGS_DIR / log_folder_name\r\n    if not log_folder.is_dir():\r\n        return False\r\n\r\n    ARCHIVES_DIR.mkdir(parents=True, exist_ok=True)\r\n    out_path = ARCHIVES_DIR / archive_name\r\n\r\n    result = subprocess.run(\r\n        [\"tar\", \"-czf\", str(out_path), \"-C\", str(LOGS_DIR), log_folder_name],\r\n        stdout=subprocess.DEVNULL,\r\n        stderr=subprocess.DEVNULL,\r\n    )\r\n\r\n"]
[26.426197, "o", "    return result.returncode == 0 and out_path.is_file()\r\n"]
