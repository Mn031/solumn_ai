[?2004limport os
import subprocess
from pathlib import Path


LOGS_DIR = Path("/workspace/logs")
ARCHIVES_DIR = Path("/workspace/archives")


def _is_plain_name(value):
    """Return True when value is a simple file/folder name, not a path."""
    if not isinstance(value, str) or not value:
        return False
    path = Path(value)
    return not path.is_absolute() and path.name == value and value not in {".", ".."}


def archive_logs(log_folder_name, archive_name):
    """
    Compress /workspace/logs/<log_folder_name> into
    /workspace/archives/<archive_name> using tar gzip archiving.

    Returns True only if tar succeeds and the archive file exists.
    """
    if not _is_plain_name(log_folder_name) or not _is_plain_name(archive_name):
        return False

    log_folder = LOGS_DIR / log_folder_name
    if not log_folder.is_dir():
        return False

    ARCHIVES_DIR.mkdir(parents=True, exist_ok=True)
    out_path = ARCHIVES_DIR / archive_name

    result = subprocess.run(
        ["tar", "-czf", str(out_path), "-C", str(LOGS_DIR), log_folder_name],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )

    return result.returncode == 0 and out_path.is_file()
