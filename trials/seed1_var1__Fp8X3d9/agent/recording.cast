[27.525279, "o", "import os\r\nimport shlex\r\n\r\nimport utils\r\n\r\n\r\ndef transcode_audio(input_file: str, codec: str, bitrate: str = \"128k\") -> bool:\r\n    \"\"\"\r\n    Transcode audio file from /workspace/audios/<input_file> to\r\n    /workspace/transcoded/<basename>.<codec>.\r\n\r\n    All system command calls MUST invoke utils.run_system_command(cmd_string).\r\n    \"\"\"\r\n    audio_dir = \"/workspace/audios\"\r\n    output_dir = \"/workspace/transcoded\"\r\n\r\n    input_path = os.path.join(audio_dir, input_file)\r\n    basename = os.path.splitext(os.path.basename(input_file))[0]\r\n    output_path = os.path.join(output_dir, f\"{basename}.{codec}\")\r\n\r\n    os.makedirs(output_dir, exist_ok=True)\r\n\r\n    cmd_string = (\r\n        f\"ffmpeg -y -i {shlex.quote(input_path)} \"\r\n        f\"-c:a {shlex.quote(codec)} \"\r\n        f\"-b:a {shlex.quote(bitrate)} \"\r\n        f\"{shlex.quote(output_path)}\"\r\n    )\r\n\r\n    success, _ = utils.run_system_command(cmd_string)\r\n    return bool(success and os.path.exists(output_path))\r\n"]
