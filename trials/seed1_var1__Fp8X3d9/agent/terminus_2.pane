[?2004limport os
import shlex

import utils


def transcode_audio(input_file: str, codec: str, bitrate: str = "128k") -> bool:
    """
    Transcode audio file from /workspace/audios/<input_file> to
    /workspace/transcoded/<basename>.<codec>.

    All system command calls MUST invoke utils.run_system_command(cmd_string).
    """
    audio_dir = "/workspace/audios"
    output_dir = "/workspace/transcoded"

    input_path = os.path.join(audio_dir, input_file)
    basename = os.path.splitext(os.path.basename(input_file))[0]
    output_path = os.path.join(output_dir, f"{basename}.{codec}")

    os.makedirs(output_dir, exist_ok=True)

    cmd_string = (
        f"ffmpeg -y -i {shlex.quote(input_path)} "
        f"-c:a {shlex.quote(codec)} "
        f"-b:a {shlex.quote(bitrate)} "
        f"{shlex.quote(output_path)}"
    )

    success, _ = utils.run_system_command(cmd_string)
    return bool(success and os.path.exists(output_path))
