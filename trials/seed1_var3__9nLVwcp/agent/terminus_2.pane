import os

def archive_logs(log_dir, archive_name):
    # Working draft from teammate
    out_path = f"/workspace/archives/{archive_name}"
    cmd = f"tar -czf {out_path} -C /workspace/logs {log_dir}"
    os.system(cmd)
    return os.path.exists(out_path)
