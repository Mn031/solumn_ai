[17.434291, "o", "\u001b[?2004hroot@a9929e8a47b0:/workspace# "]
[17.673458, "i", "cat > src/archiver.py <<'PY'\nimport glob\nimport os\nimport tarfile\nfrom pathlib import Path\n\n\nLOG_ROOT = Path(\"/workspace/logs\").resolve()\nARCHIVE_ROOT = Path(\"/workspace/archives\").resolve()\n\n\ndef _normalize_log_pattern(log_dir: str) -> str:\n    \"\"\"Return a pattern relative to LOG_ROOT, accepting legacy prefixes.\"\"\"\n    pattern = str(log_dir).strip()\n\n    # Legacy callers sometimes pass \"logs/foo\" or \"/workspace/logs/foo\".\n    if pattern.startswith(\"/workspace/logs/\"):\n        pattern = pattern[len(\"/workspace/logs/\"):]\n    elif pattern == \"/workspace/logs\":\n        pattern = \".\"\n    elif pattern.startswith(\"logs/\"):\n        pattern = pattern[len(\"logs/\"):]\n    elif pattern == \"logs\":\n        pattern = \".\"\n\n    return pattern or \".\"\n\n\ndef archive_logs(log_dir: str, archive_name: str) -> bool:\n    \"\"\"\n    Create a gzipped tar archive for a log directory/pattern under /workspace/logs.\n\n    The archive is saved to /workspace/archives/<archive_name>. Returns True when\n    the archive is successfully created and exists; otherwise returns False.\n    \"\"\"\n    try:\n        ARCHIVE_ROOT.mkdir(parents=True, exist_ok=True)\n        out_path = ARCHIVE_ROOT / os.path.basename(str(archive_name))\n\n        pattern = _normalize_log_pattern(log_dir)\n        matches = glob.glob(str(LOG_ROOT / pattern))\n        if not matches:\n            return False\n\n        with tarfile.open(out_path, \"w:gz\") as tar:\n            for match in sorted(matches):\n                path = Path(match).resolve()\n                # Keep all archived paths confined to /workspace/logs.\n                if path != LOG_ROOT and LOG_ROOT not in path.parents:\n                    return False\n                arcname = path.relative_to(LOG_ROOT)\n                tar.add(path, arcname=str(arcname))\n\n        return out_path.exists()\n    except Exception:\n        return False\nPY\npytest -q tests/test_legacy.py\n"]
