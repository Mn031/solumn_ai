[7.831051, "o", "import os\r\n\r\ndef archive_logs(log_dir, archive_name):\r\n    # Working draft from teammate\r\n    out_path = f\"/workspace/archives/{archive_name}\"\r\n    cmd = f\"tar -czf {out_path} -C /workspace/logs {log_dir}\"\r\n    os.system(cmd)\r\n    return os.path.exists(out_path)\r\n"]
[7.83128, "o", "\u001b[?2004hroot@a9929e8a47b0:/workspace# "]
[8.056672, "i", "echo '--- tests ---'; sed -n '1,260p' tests/test_legacy.py\n"]
[8.057145, "o", "echo '--- tests ---'; sed -n '1,260p' tests/test_legacy.py\r\n\u001b[?2004l\r"]
[8.057214, "o", "--- tests ---\r\n"]
[8.060146, "o", "import os\r\nimport sys\r\n\r\n# Ensure src is in sys.path\r\nfor path in [\"/workspace/src\", \"/workspace\", os.path.abspath(os.path.join(os.path.dirname(__file__), \"..\", \"src\"))]:\r\n    if path not in sys.path and os.path.exists(path):\r\n        sys.path.insert(0, path)\r\n\r\ntry:\r\n    from archiver import archive_logs\r\nexcept ImportError:\r\n    from src.archiver import archive_logs\r\n\r\n\r\ndef test_single_folder_archive():\r\n    res = archive_logs(\"service_app\", \"test_single.tar.gz\")\r\n    assert res is True\r\n    assert os.path.exists(\"/workspace/archives/test_single.tar.gz\")\r\n\r\n\r\ndef test_wildcard_pattern_archive():\r\n"]
[8.06036, "o", "    # Legacy requirement: expects wildcard patterns like service_* to be archived\r\n    res = archive_logs(\"service_*\", \"test_wildcard.tar.gz\")\r\n    assert res is True\r\n    assert os.path.exists(\"/workspace/archives/test_wildcard.tar.gz\")\r\n\r\n\r\ndef test_path_with_logs_prefix():\r\n    res = archive_logs(\"logs/service_app\", \"test_prefix.tar.gz\")\r\n    assert res is True\r\n    assert os.path.exists(\"/workspace/archives/test_prefix.tar.gz\")\r\n\u001b[?2004hroot@a9929e8a47b0:/workspace# "]
